# Copia este archivo como `.env` y completa los valores.
# `.env` está en .gitignore: nunca lo subas al repositorio.

# MinIO (el nombre de host `minio` es el del servicio en docker-compose.yml)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Token para entrar a JupyterLab en http://localhost:8888
JUPYTER_TOKEN=

# Imagen del servidor de almacenamiento. MinIO retiró minio/minio de Docker Hub en septiembre
# de 2026; por defecto se usa pgsty/silo, una bifurcación de MinIO. Descomenta para cambiarla.
# MINIO_IMAGE=pgsty/silo:RELEASE.2026-09-16T00-00-00Z
